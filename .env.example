# Copy to .env (git-ignored) and set your own strong password.
# SQL Server requires a strong password (8+ chars, upper/lower/digit/symbol).
# Never commit the real .env or reuse a value that appears in this repository.
MSSQL_SA_PASSWORD=<set-a-strong-password>

# First admin account created at startup if none exists (leave blank to skip).
# Password must be at least 10 characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<set-a-strong-admin-password>

# Signing key for login tokens (JWT): at least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=<set-a-random-32+-character-secret>
